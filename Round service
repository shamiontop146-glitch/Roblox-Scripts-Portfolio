--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Remotes = require(
	ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes")
)

local roundRemote: RemoteEvent = Remotes.Round
local whipRemote: RemoteEvent = Remotes.Whip

local DataService = require(
	script.Parent.Parent:WaitForChild("Services"):WaitForChild("DataService")
)

local QuestService = require(
	script.Parent.Parent:WaitForChild("Services"):WaitForChild("QuestService")
)

local Config = require(
	ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
)

local RoundService = {}

local INTERMISSION_TIME = 15
local MAP_CHOOSING_TIME = 10
local ROUND_TIME = 300
local MAP_LOAD_TIME = 1.5
local WINNER_DISPLAY_TIME = 3
local MIN_PLAYERS = 2

local MATCH_WALK_SPEED = 28
local DEFAULT_WALK_SPEED = 20

local PASSIVE_REGEN_PERCENT_PER_SECOND = 0.01
local PASSIVE_REGEN_TICK = 0.1

local mapsFolder = ReplicatedStorage:FindFirstChild("Maps")
local whipTemplate = ReplicatedStorage:FindFirstChild("LassoWhip") :: Tool?

local currentState = "Intermission"
local currentCountdown = INTERMISSION_TIME

local activePlayers: {Player} = {}
local matchParticipants: {[Player]: boolean} = {}

local roundActive = false

local playerSpawns: {[Player]: CFrame} = {}
local playerRespawnConn: {[Player]: RBXScriptConnection} = {}
local playerHealthWatchConn: {[Player]: RBXScriptConnection} = {}

local currentMap: Instance? = nil
local lastChosenMapName: string? = nil

local originalLightingChildren: {Instance} = {}
local volcanoLightingApplied = false

local initialized = false

local function disableDefaultHealthRegeneration(character: Model)
	local healthScript = character:FindFirstChild("Health")

	if healthScript then
		healthScript:Destroy()
	end

	task.defer(function()
		if not character.Parent then
			return
		end

		local delayedHealthScript = character:FindFirstChild("Health")

		if delayedHealthScript then
			delayedHealthScript:Destroy()
		end
	end)

	local connection: RBXScriptConnection?

	connection = character.ChildAdded:Connect(function(child)
		if child.Name == "Health" then
			child:Destroy()
		end
	end)

	character.Destroying:Connect(function()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end)
end

local function setFullHealth(player: Player)
	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if humanoid.Health > 0 then
		humanoid.Health = humanoid.MaxHealth
	end
end

local function regeneratePlayer(
	player: Player,
	deltaTime: number
)
	if player:GetAttribute("InMatch") == true then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	if humanoid.Health >= humanoid.MaxHealth then
		return
	end

	local regenerationAmount =
		humanoid.MaxHealth
		* PASSIVE_REGEN_PERCENT_PER_SECOND
		* deltaTime

	humanoid.Health = math.min(
		humanoid.Health + regenerationAmount,
		humanoid.MaxHealth
	)
end

local function startPassiveRegeneration()
	task.spawn(function()
		while true do
			local deltaTime = task.wait(PASSIVE_REGEN_TICK)

			for _, player in Players:GetPlayers() do
				regeneratePlayer(
					player,
					deltaTime
				)
			end
		end
	end)
end

local function setupCharacterHealth(
	player: Player,
	character: Model
)
	disableDefaultHealthRegeneration(character)

	if playerHealthWatchConn[player] then
		playerHealthWatchConn[player]:Disconnect()
		playerHealthWatchConn[player] = nil
	end

	local connection =
		character.ChildAdded:Connect(function(child)
			if child:IsA("Humanoid") then
				disableDefaultHealthRegeneration(character)

				task.defer(function()
					if not child.Parent then
						return
					end

					if player:GetAttribute("InMatch") ~= true then
						if child.Health > 0 then
							child.Health = child.MaxHealth
						end
					end
				end)
			end
		end)

	playerHealthWatchConn[player] = connection

	task.defer(function()
		if player.Character ~= character then
			return
		end

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if not humanoid then
			return
		end

		if player:GetAttribute("InMatch") ~= true then
			if humanoid.Health > 0 then
				humanoid.Health = humanoid.MaxHealth
			end
		end
	end)
end

local function isAFK(player: Player): boolean
	return player:GetAttribute("AFK") == true
end

local function getActivePlayerCount(): number
	local count = 0

	for _, player in Players:GetPlayers() do
		if not isAFK(player) then
			count += 1
		end
	end

	return count
end

local function resolveLobbySpawn(): BasePart?
	local lobby = workspace:FindFirstChild("Lobby")

	if not lobby then
		return nil
	end

	local inner = lobby:FindFirstChild("Lobby")

	if not inner then
		return nil
	end

	local spawnLocation = inner:FindFirstChild("SpawnLocation")

	if spawnLocation and spawnLocation:IsA("BasePart") then
		return spawnLocation
	end

	return nil
end

local lobbySpawn = resolveLobbySpawn()

local function getSpawnLocations(
	mapInstance: Instance?
): {BasePart}
	local spawns: {BasePart} = {}

	if mapInstance then
		local spawnsFolder = mapInstance:FindFirstChild("Spawns")

		if spawnsFolder then
			for _, child in spawnsFolder:GetChildren() do
				if child:IsA("BasePart") then
					table.insert(
						spawns,
						child
					)
				end
			end
		end
	end

	return spawns
end

local function teleportPlayer(
	player: Player,
	targetCFrame: CFrame
)
	if isAFK(player) then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local hrp = character:FindFirstChild(
		"HumanoidRootPart"
	)

	if hrp and hrp:IsA("BasePart") then
		pcall(function()
			player:RequestStreamingAround(
				targetCFrame.Position
			)
		end)

		hrp.CFrame = targetCFrame
		hrp.Anchored = true

		task.delay(1, function()
			if hrp and hrp.Parent then
				hrp.Anchored = false
			end
		end)
	end
end

local function giveWhip(player: Player)
	if isAFK(player) then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local existing =
		character:FindFirstChild("LassoWhip")

	if existing then
		existing:Destroy()
	end

	local backpack =
		player:FindFirstChild("Backpack")

	if backpack then
		local existingBackpack =
			backpack:FindFirstChild("LassoWhip")

		if existingBackpack then
			existingBackpack:Destroy()
		end
	end

	if whipTemplate then
		local whip = whipTemplate:Clone()
		whip.CanBeDropped = false
		whip.Parent = character
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		if character:GetAttribute("BlitzActive") == true then
			humanoid.WalkSpeed =
				MATCH_WALK_SPEED * 1.25
		else
			humanoid.WalkSpeed =
				MATCH_WALK_SPEED
		end
	end
end

local function removeWhip(player: Player)
	local character = player.Character

	if character then
		local whip =
			character:FindFirstChild("LassoWhip")

		if whip then
			whip:Destroy()
		end

		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid.WalkSpeed =
				DEFAULT_WALK_SPEED
		end
	end

	local backpack =
		player:FindFirstChild("Backpack")

	if backpack then
		local whip =
			backpack:FindFirstChild("LassoWhip")

		if whip then
			whip:Destroy()
		end
	end

	whipRemote:FireAllClients(
		"Unequip",
		player
	)
end

local function getAvailableMaps(): {Instance}
	local maps: {Instance} = {}

	if mapsFolder then
		for _, child in mapsFolder:GetChildren() do
			table.insert(
				maps,
				child
			)
		end
	end

	return maps
end

local function saveOriginalLighting()
	originalLightingChildren = {}

	for _, child in Lighting:GetChildren() do
		table.insert(
			originalLightingChildren,
			child
		)
	end
end

local function applyVolcanoLighting(
	mapInstance: Instance
)
	local lightingFolder =
		mapInstance:FindFirstChild("Lighting")

	if not lightingFolder then
		return
	end

	saveOriginalLighting()

	for _, child in originalLightingChildren do
		child.Parent = nil
	end

	for _, child in lightingFolder:GetChildren() do
		child.Parent = Lighting
	end

	volcanoLightingApplied = true
end

local function restoreOriginalLighting()
	if not volcanoLightingApplied then
		return
	end

	for _, child in Lighting:GetChildren() do
		child.Parent = nil
	end

	for _, child in originalLightingChildren do
		child.Parent = Lighting
	end

	volcanoLightingApplied = false
	originalLightingChildren = {}
end

local function chooseMap(
	maps: {Instance}
): Instance
	if #maps == 1 or lastChosenMapName == nil then
		return maps[
			math.random(
				1,
				#maps
			)
		]
	end

	local available: {Instance} = {}

	for _, map in ipairs(maps) do
		if map.Name ~= lastChosenMapName then
			table.insert(
				available,
				map
			)
		end
	end

	if #available > 0 then
		return available[
			math.random(
				1,
				#available
			)
		]
	end

	return maps[
		math.random(
			1,
			#maps
		)
	]
end

local function spawnMap(): Instance?
	local maps = getAvailableMaps()

	if #maps == 0 then
		return nil
	end

	if currentMap then
		currentMap.Parent = nil
		currentMap = nil
	end

	restoreOriginalLighting()

	local chosenMap = chooseMap(maps)

	lastChosenMapName =
		chosenMap.Name

	local newMap =
		chosenMap:Clone()

	currentMap =
		newMap

	newMap.Parent =
		workspace

	if string.lower(
		chosenMap.Name
		) == "volcanomap"
	then
		applyVolcanoLighting(
			newMap
		)
	end

	return newMap
end

local function removeCurrentMap()
	if currentMap then
		currentMap.Parent = nil
		currentMap = nil
	end

	restoreOriginalLighting()
end

local function removePlayerFromActiveList(
	player: Player
)
	for i, activePlayer in ipairs(activePlayers) do
		if activePlayer == player then
			table.remove(
				activePlayers,
				i
			)
			break
		end
	end
end

local function syncPlayerToCurrentState(
	player: Player
)
	if not player.Parent then
		return
	end

	if currentState == "Round" and roundActive then
		roundRemote:FireClient(
			player,
			"Round",
			currentCountdown
		)
	elseif currentState == "ChoosingMap" then
		roundRemote:FireClient(
			player,
			"ChoosingMap",
			currentCountdown
		)
	elseif currentState == "Intermission" then
		roundRemote:FireClient(
			player,
			"Intermission",
			currentCountdown
		)
	else
		roundRemote:FireClient(
			player,
			currentState,
			currentCountdown
		)
	end
end

local function onMatchRespawn(
	player: Player,
	character: Model
)
	player:SetAttribute(
		"InMatch",
		false
	)

	removeWhip(player)
	removePlayerFromActiveList(player)

	playerSpawns[player] = nil

	if playerRespawnConn[player] then
		playerRespawnConn[player]:Disconnect()
		playerRespawnConn[player] = nil
	end

	disableDefaultHealthRegeneration(
		character
	)

	local hrp =
		character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	local humanoid =
		character:WaitForChild(
			"Humanoid",
			10
		)

	if not hrp or not humanoid then
		syncPlayerToCurrentState(player)
		return
	end

	task.wait(0.5)

	if player.Character ~= character then
		return
	end

	if humanoid.Health > 0 then
		humanoid.Health =
			humanoid.MaxHealth
	end

	if lobbySpawn then
		hrp.CFrame =
			lobbySpawn.CFrame
			+ Vector3.new(
				0,
				3,
				0
			)
	end

	syncPlayerToCurrentState(player)
end

local function addPlayerToMatch(
	player: Player,
	spawnCFrame: CFrame
)
	if isAFK(player) then
		return
	end

	player:SetAttribute(
		"InMatch",
		true
	)

	playerSpawns[player] =
		spawnCFrame

	table.insert(
		activePlayers,
		player
	)

	matchParticipants[player] =
		true

	if player.Character then
		disableDefaultHealthRegeneration(
			player.Character
		)
	end

	setFullHealth(player)
	giveWhip(player)

	if playerRespawnConn[player] then
		playerRespawnConn[player]:Disconnect()
		playerRespawnConn[player] = nil
	end

	playerRespawnConn[player] =
		player.CharacterAdded:Connect(
			function(character)
				if player:GetAttribute(
					"InMatch"
					) == true then
					onMatchRespawn(
						player,
						character
					)
				else
					setupCharacterHealth(
						player,
						character
					)
				end
			end
		)
end

local function removePlayerFromMatch(
	player: Player
)
	player:SetAttribute(
		"InMatch",
		false
	)

	removeWhip(player)

	setFullHealth(player)

	playerSpawns[player] = nil

	if playerRespawnConn[player] then
		playerRespawnConn[player]:Disconnect()
		playerRespawnConn[player] = nil
	end
end

local function countAlive(): (
	number,
	Player?
	)
	local alive = 0
	local lastAlive: Player? = nil

	for _, player in ipairs(activePlayers) do
		if isAFK(player) then
			continue
		end

		local character =
			player.Character

		local humanoid =
			character
			and character:FindFirstChildOfClass(
				"Humanoid"
			) :: Humanoid?

		if humanoid
			and humanoid.Health > 0
		then
			alive += 1
			lastAlive = player
		end
	end

	return alive, lastAlive
end

function RoundService.init()
	if initialized then
		warn(
			"[RoundService] Already initialized."
		)

		return
	end

	initialized = true

	startPassiveRegeneration()

	for _, player in Players:GetPlayers() do
		if player.Character then
			setupCharacterHealth(
				player,
				player.Character
			)
		end

		player.CharacterAdded:Connect(
			function(character)
				if player:GetAttribute(
					"InMatch"
					) ~= true then
					setupCharacterHealth(
						player,
						character
					)
				end
			end
		)
	end

	Players.PlayerRemoving:Connect(
		function(player)
			if player:GetAttribute(
				"InMatch"
				) == true
			then
				removePlayerFromMatch(
					player
				)
			end

			removePlayerFromActiveList(
				player
			)

			matchParticipants[player] =
				nil

			playerSpawns[player] =
				nil

			if playerRespawnConn[player] then
				playerRespawnConn[player]:Disconnect()
				playerRespawnConn[player] = nil
			end

			if playerHealthWatchConn[player] then
				playerHealthWatchConn[player]:Disconnect()
				playerHealthWatchConn[player] = nil
			end
		end
	)

	Players.PlayerAdded:Connect(
		function(player)
			player.CharacterAdded:Connect(
				function(character)
					if player:GetAttribute(
						"InMatch"
						) ~= true
					then
						setupCharacterHealth(
							player,
							character
						)
					end
				end
			)

			task.wait(2)

			roundRemote:FireClient(
				player,
				currentState,
				currentCountdown
			)
		end
	)
end

function RoundService.start()
	while true do
		while getActivePlayerCount()
			< MIN_PLAYERS
		do
			currentState =
				"WaitingForPlayers"

			currentCountdown =
				0

			roundRemote:FireAllClients(
				"WaitingForPlayers",
				0
			)

			task.wait(1)
		end

		currentState =
			"Intermission"

		for _, player in Players:GetPlayers() do
			removeWhip(player)

			player:SetAttribute(
				"InMatch",
				false
			)

			setFullHealth(player)
		end

		local cancelled =
			false

		for i = INTERMISSION_TIME, 0, -1 do
			if getActivePlayerCount()
				< MIN_PLAYERS
			then
				cancelled =
					true

				break
			end

			currentCountdown =
				i

			roundRemote:FireAllClients(
				"Intermission",
				i
			)

			task.wait(1)
		end

		if cancelled then
			currentState =
				"WaitingForPlayers"

			currentCountdown =
				0

			roundRemote:FireAllClients(
				"WaitingForPlayers",
				0
			)

			continue
		end

		roundRemote:FireAllClients(
			"HideIntermission",
			0
		)

		currentState =
			"ChoosingMap"

		cancelled =
			false

		for i = MAP_CHOOSING_TIME, 0, -1 do
			if getActivePlayerCount()
				< MIN_PLAYERS
			then
				cancelled =
					true

				break
			end

			currentCountdown =
				i

			roundRemote:FireAllClients(
				"ChoosingMap",
				i
			)

			task.wait(1)
		end

		if cancelled then
			currentState =
				"WaitingForPlayers"

			currentCountdown =
				0

			roundRemote:FireAllClients(
				"WaitingForPlayers",
				0
			)

			continue
		end

		roundRemote:FireAllClients(
			"HideChoosingMap",
			0
		)

		if getActivePlayerCount()
			< MIN_PLAYERS
		then
			currentState =
				"WaitingForPlayers"

			currentCountdown =
				0

			roundRemote:FireAllClients(
				"WaitingForPlayers",
				0
			)

			continue
		end

		local mapInstance =
			spawnMap()

		task.wait(
			MAP_LOAD_TIME
		)

		activePlayers = {}
		playerSpawns = {}
		matchParticipants = {}

		local spawns =
			getSpawnLocations(
				mapInstance
			)

		for _, player in Players:GetPlayers() do
			if isAFK(player) then
				continue
			end

			if player.Character then
				if #spawns > 0 then
					local spawnIndex =
						(
							#activePlayers
							% #spawns
						) + 1

					local spawnCF =
						spawns[spawnIndex].CFrame
						+ Vector3.new(
							0,
							3,
							0
						)

					addPlayerToMatch(
						player,
						spawnCF
					)

					teleportPlayer(
						player,
						spawnCF
					)
				else
					addPlayerToMatch(
						player,
						CFrame.new(
							0,
							10,
							0
						)
					)
				end
			end
		end

		if #activePlayers
			< MIN_PLAYERS
		then
			for _, player in ipairs(
				activePlayers
				) do
				removePlayerFromMatch(
					player
				)
			end

			activePlayers = {}

			removeCurrentMap()

			currentState =
				"WaitingForPlayers"

			currentCountdown =
				0

			roundRemote:FireAllClients(
				"WaitingForPlayers",
				0
			)

			continue
		end

		roundRemote:FireAllClients(
			"MatchStart",
			0
		)

		for _, participant in ipairs(
			activePlayers
			) do
			QuestService.addProgress(
				participant,
				"PlayRounds",
				1
			)
		end

		currentState =
			"Round"

		roundActive =
			true

		local startingPlayerCount =
			#activePlayers

		local winner: Player? =
			nil

		for i = ROUND_TIME, 0, -1 do
			currentCountdown =
				i

			if startingPlayerCount >= 2 then
				local aliveCount, lastAlive =
					countAlive()

				if aliveCount <= 1 then
					winner =
						if aliveCount == 1
						then lastAlive
						else nil

					break
				end
			end

			for _, player in ipairs(
				activePlayers
				) do
				if isAFK(player) then
					continue
				end

				roundRemote:FireClient(
					player,
					"Round",
					i
				)

				local char =
					player.Character

				if char
					and char:FindFirstChild(
						"Humanoid"
					)
				then
					local hasWhip =
						char:FindFirstChild(
							"LassoWhip"
						)

					if not hasWhip then
						local backpack =
							player:FindFirstChild(
								"Backpack"
							)

						if backpack then
							hasWhip =
								backpack:FindFirstChild(
									"LassoWhip"
								)
						end
					end

					if not hasWhip
						and player:GetAttribute(
							"InMatch"
						)
					then
						giveWhip(player)

						whipRemote:FireAllClients(
							"Equip",
							player
						)
					end
				end
			end

			task.wait(1)
		end

		if winner
			and not isAFK(winner)
		then
			DataService.addCoins(
				winner,
				Config.Coins.Win
			)

			DataService.incrementStat(
				winner,
				"Wins",
				1
			)

			QuestService.addProgress(
				winner,
				"WinRounds",
				1
			)

			roundRemote:FireAllClients(
				"Winner",
				winner.Name
			)

			task.wait(
				WINNER_DISPLAY_TIME
			)
		end

		for participant in matchParticipants do
			if participant.Parent
				and not isAFK(participant)
			then
				DataService.addCoins(
					participant,
					Config.Coins.Participation
				)
			end
		end

		for _, player in ipairs(
			activePlayers
			) do
			if player.Parent then
				roundRemote:FireClient(
					player,
					"HideRound",
					0
				)
			end
		end

		roundRemote:FireAllClients(
			"MatchEnd",
			0
		)

		roundActive =
			false

		for _, player in Players:GetPlayers() do
			if player.Parent then
				player:SetAttribute(
					"InMatch",
					false
				)

				removeWhip(player)

				if not isAFK(player) then
					if lobbySpawn then
						teleportPlayer(
							player,
							lobbySpawn.CFrame
								+ Vector3.new(
									0,
									3,
									0
								)
						)
					end

					setFullHealth(player)
				end
			end
		end

		activePlayers = {}
		matchParticipants = {}
		playerSpawns = {}

		removeCurrentMap()

		currentState =
			"WaitingForPlayers"

		currentCountdown =
			0

		task.wait(1)
	end
end

return RoundService
