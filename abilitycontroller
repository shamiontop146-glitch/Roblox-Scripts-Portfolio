local function loadAbilities()
	local folder = Shared:FindFirstChild("Abilities")

	if not folder then
		return
	end

	for _, moduleScript in folder:GetChildren() do
		if moduleScript:IsA("ModuleScript") then
			local ok, ability =
				pcall(require, moduleScript)

			if ok
				and type(ability) == "table"
				and ability.id
			then
				abilities[ability.id] =
					ability
			end
		end
	end
end

