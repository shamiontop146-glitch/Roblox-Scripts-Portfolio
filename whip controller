local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WhipEvent = ReplicatedStorage:WaitForChild("WhipEvent")
local ChainsVFXEvent = ReplicatedStorage:WaitForChild("ChainsVFXEvent")
local ChainsVFXFolder = ReplicatedStorage:WaitForChild("chains vfx")
local ItemCatalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemCatalog"))
local DataController = require(script.Parent:WaitForChild("DataController"))
local localPlayer = Players.LocalPlayer

local activeWhips = {}

local STRIKE_DURATION = 0.35
local SEGMENT_COUNT = 64
local NODE_COUNT = SEGMENT_COUNT + 1
local LASSO_STEM_FRACTION = 0.2
local LASSO_RADIUS = 3.35
local LASSO_SPIN_SPEED = -9.5
local TAU = math.pi * 2

local LOCAL_INVISIBILITY_WHIP_TRANSPARENCY = 0.55
local REMOTE_INVISIBILITY_WHIP_TRANSPARENCY = 1

local LASSO_ANIM_ID = "rbxassetid://100052788464724"
local WALK_LASSO_ANIM_ID = "rbxassetid://115509844307010"
local STRIKE_ANIM_ID = "rbxassetid://133581478172410"
local MATCH_JUMP_ANIM_ID = "rbxassetid://134309439530669"

local DEFAULT_LASSO_ID = "DefaultLasso"

local function smoothstep(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function getBaseCFrame(player, char)
	local tool = char:FindFirstChild("LassoWhip")
	local handle = tool and tool:FindFirstChild("Handle")

	if handle then
		return handle.CFrame
	end

	local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")

	if rightHand then
		return rightHand.CFrame
	end

	return char.PrimaryPart and char.PrimaryPart.CFrame or CFrame.new()
end

local function getLocalEquippedLasso(): string
	local data = DataController.get()

	if data
		and data.Equipped
		and type(data.Equipped.Lasso) == "string"
		and data.Equipped.Lasso ~= ""
	then
		return data.Equipped.Lasso
	end

	return DEFAULT_LASSO_ID
end

local function updateWhipTransparency(player, visuals)
	if not visuals then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local isInvisible = character:GetAttribute("InvisibilityActive") == true

	local transparency = 0

	if player == localPlayer then
		if getLocalEquippedLasso() ~= DEFAULT_LASSO_ID then
			transparency = 1
		elseif isInvisible then
			transparency = LOCAL_INVISIBILITY_WHIP_TRANSPARENCY
		end
	else
		if isInvisible then
			transparency = REMOTE_INVISIBILITY_WHIP_TRANSPARENCY
		end
	end

	for _, part in ipairs(visuals.segments) do
		part.Transparency = transparency
	end

	visuals.tipPart.Transparency = transparency
end

